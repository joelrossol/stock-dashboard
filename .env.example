# Data source: "auto" (live Schwab when connected, otherwise sample data), "mock", or "live"
DATA_MODE=auto

# Schwab Trader API (Phase 2) — developer.schwab.com
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:3000/api/auth/schwab/callback

# Finnhub free tier (Phase 3) — finnhub.io
FINNHUB_API_KEY=

# Encrypts stored OAuth tokens (generate with: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# Database: leave empty for a local SQLite file at data/dashboard.db; set for Turso on Vercel
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Login (set with: npm run set-password — never put the plain password here)
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
AUTH_SECRET=

# Vercel only (Phase 4)
CRON_SECRET=
